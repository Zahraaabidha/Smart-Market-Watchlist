# Copy to .env for local development. Never commit the real .env.
ENVIRONMENT=development
DEMO_MODE=true

DATABASE_URL=postgresql+psycopg://watchlist:watchlist@localhost:5432/watchlist

# CORS. Defaults to http://localhost:5173 only. In production, set this to
# the deployed frontend's exact origin(s) as a JSON array, or the API will
# reject requests from it.
# CORS_ORIGINS=["https://your-frontend-domain.example.com"]

# Required when ENVIRONMENT=production; the app refuses to start on the
# demo default. Generate with: python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=insecure-demo-key-do-not-use-in-production

INGEST_INTERVAL_SECONDS=15
BASELINE_WINDOW_SIZE=40

# Market data source. "replay" (default) is the deterministic simulator and
# needs no credentials. "live" wraps Twelve Data and automatically falls back
# to replay on any failure, so the product never goes dark.
MARKET_PROVIDER=replay
# TWELVE_DATA_API_KEY=your-key-here
# TWELVE_DATA_EXCHANGE=NSE

# Google Sign-In. The client id is public (it's shipped to the frontend as
# VITE_GOOGLE_CLIENT_ID too); no client secret is needed since we only verify
# ID tokens. Leave unset to disable the "Continue with Google" endpoint.
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
