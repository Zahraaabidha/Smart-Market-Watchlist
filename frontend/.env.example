# Copy to .env for local development. Never commit the real .env.

# Google Sign-In. Public by design (it's the audience a credential is
# checked against, not a secret) -- safe to ship to the browser. Must match
# GOOGLE_CLIENT_ID on the backend. Leave unset and the "Continue with
# Google" button shows as unavailable instead of failing.
# VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
